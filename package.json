{
  "name": "wrangler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"uv run --directory api python src/main.py\" \"pnpm --filter ./web dev\"",
    "dev:api": "uv run --directory api python src/main.py",
    "dev:web": "pnpm --filter \"./web\" dev",
    "build": "pnpm --filter \"./*\" build",
    "lint": "pnpm --filter \"./*\" lint",
    "lint:fix": "pnpm --filter \"./*\" lint:fix",
    "format": "pnpm --filter \"./*\" format",
    "format:fix": "pnpm --filter \"./*\" format:fix",
    "test": "pnpm --filter \"./*\" test"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
